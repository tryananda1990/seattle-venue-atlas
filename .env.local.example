# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server-only, never expose to the browser. Used
# by the admin import tool to write venues bypassing RLS.
SUPABASE_SECRET_KEY=

# Mapbox — account.mapbox.com/access-tokens (a public/default token is fine)
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenRouter — openrouter.ai/keys (used server-side only, for the AI venue
# data-extraction tool in the admin console)
OPENROUTER_API_KEY=
# Optional — defaults to anthropic/claude-haiku-4.5 if unset. Any OpenRouter
# model slug that supports JSON mode works.
OPENROUTER_MODEL=

# Admin console — PIN-gated, single admin (see src/lib/admin-auth.ts).
# Pick a long PIN (8+ characters, letters+numbers): a short numeric PIN has
# no brute-force lockout behind it yet, only a fixed per-attempt delay.
ADMIN_PIN=
# Random signing secret for the admin session cookie — generate with
# `openssl rand -hex 32`. Not the PIN itself; never share it.
ADMIN_SESSION_SECRET=

# Google Places API — console.cloud.google.com (used for venue discovery only;
# see PRD §6 for the compliance note on what this key may and may not be used for)
GOOGLE_PLACES_API_KEY=

# Set to the deployed URL on Vercel; localhost is fine for development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
