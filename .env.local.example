# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the browser. Used by the
# admin import tool to write venues bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — account.mapbox.com/access-tokens (a public/default token is fine)
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenRouter — openrouter.ai/keys (used server-side only, for the AI venue
# data-extraction tool in the admin console)
OPENROUTER_API_KEY=

# Google Places API — console.cloud.google.com (used for venue discovery only;
# see PRD §6 for the compliance note on what this key may and may not be used for)
GOOGLE_PLACES_API_KEY=

# Set to the deployed URL on Vercel; localhost is fine for development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
